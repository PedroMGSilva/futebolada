{
  "name": "futebolada",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "node ./server.js",
    "start": "cross-env NODE_ENV=production node ./server.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "migrate": "node-pg-migrate up -j js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@napi-rs/canvas": "^1.0.3",
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "isbot": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "pg-migrate": {
    "dir": "migrations",
    "migrations-table": "pgmigrations",
    "database-url-env": true,
    "tsconfig": "./tsconfig.json"
  }
}
